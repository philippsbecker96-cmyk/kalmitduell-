<workout_file>
  <author>Kalmit-Duell</author>
  <name>Beispiel: Sweet Spot 3 × 12 min</name>
  <description>Beispieldatei – kann gelöscht werden</description>
  <sportType>bike</sportType>
  <workout>
    <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.75"/>
    <IntervalsT Repeat="3" OnDuration="720" OffDuration="300" OnPower="0.9" OffPower="0.55"/>
    <Cooldown Duration="480" PowerLow="0.65" PowerHigh="0.45"/>
  </workout>
</workout_file>
