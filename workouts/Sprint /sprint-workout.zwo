<workout_file><author>mywhooshinfo.com</author><name>Sprint Workout</name><description>Channel your inner sprinter, piecing together a lot of the work completed in previous weeks. We include all three types of sprints - High Torque, High Power and Pre-Loaded Efforts - I will explain all in the session!

**IMPORTANT** Turn erg OFF for this workout.</description><sportType>bike</sportType><workout>
<SteadyState  Duration="240" Power="0.55000001192093"><textevent timeoffset="0" message="Welcome to this Sprint Workout! "/><textevent timeoffset="10" message="What is on the menu today?"/><textevent timeoffset="20" message="Sprints, Sprints and More Sprints!"/><textevent timeoffset="30" message="Remember to turn off erg. mode!"/><textevent timeoffset="40" message="The smart trainer won&#039;t be able to adjust in time for the efforts."/><textevent timeoffset="50" message="We have 4 sets of Sprints coming up. "/><textevent timeoffset="60" message="Read the instructions closely "/><textevent timeoffset="80" message="Set 1 - SEATED Big Gear Sprints "/><textevent timeoffset="90" message="Set 2 - STANDING Big Gear Sprints "/><textevent timeoffset="100" message="Set 3 - STANDING Power Sprints "/><textevent timeoffset="110" message="Set 4 - Pre-Load Sprints"/><textevent timeoffset="200" message="Look out for instructions for each set... "/></SteadyState>
<SteadyState  Duration="180" Power="0.64999997615814"><textevent timeoffset="0" message="Progressing through the zones, to ensure you are prepared for the session to come."/></SteadyState>
<SteadyState  Cadence="75" Duration="120" Power="0.80000001192093"><textevent timeoffset="0" message="Low cadence here please!"/></SteadyState>
<SteadyState  Duration="120" Power="0.89999997615814"><textevent timeoffset="0" message="Back to normal cadence "/><textevent timeoffset="10" message="This effort is to ensure you kick-start your oxygen carrying capacity and utilisation. "/><textevent timeoffset="20" message=" If your legs are hurting by now, it is NOT a bad thing! "/><textevent timeoffset="100" message="Nearly finished..."/><textevent timeoffset="110" message="...the warm up"/></SteadyState>
<SteadyState  Duration="120" Power="0.55000001192093"><textevent timeoffset="10" message="Make sure you have a drink at this point if you have not done so already"/><textevent timeoffset="30" message="Coming up is a priming effort"/><textevent timeoffset="100" message="Some cadence changers, stay seated throughout"/><textevent timeoffset="110" message="Keep good form, stay strong"/></SteadyState>
<IntervalsT   Repeat="2" OnDuration="150" OnPower="0.86000001430511" OffDuration="10" OffPower="0.86000001430511">
</IntervalsT>
<SteadyState  Duration="240" Power="0.55000001192093"><textevent timeoffset="0" message="Good Job !"/><textevent timeoffset="10" message="Here comes the first set of sprints"/><textevent timeoffset="20" message="Listen carefully"/><textevent timeoffset="30" message="All 4 sprints are to be SEATED efforts"/><textevent timeoffset="45" message="Grip the bars tight"/><textevent timeoffset="60" message="Engage your core"/><textevent timeoffset="75" message="Sprint from a big gear"/><textevent timeoffset="90" message="53x14"/><textevent timeoffset="100" message="You won&#039;t max out on power here"/><textevent timeoffset="110" message="Think of it as a torque effort"/><textevent timeoffset="120" message="If your trainer is slipping,"/><textevent timeoffset="130" message="Revert to a higher cadence (less torque)"/><textevent timeoffset="190" message="Remember, BIG GEAR"/><textevent timeoffset="200" message="And STAY SEATED"/><textevent timeoffset="220" message="Change up your gears now"/><textevent timeoffset="230" message="Let your cadence fall"/></SteadyState>
<IntervalsT   Repeat="3" OnDuration="7" OnPower="3.5" OffDuration="120" OffPower="0.55000001192093">
</IntervalsT>
<SteadyState  Duration="180" Power="0.55000001192093"><textevent timeoffset="0" message="Great work everyone!"/><textevent timeoffset="10" message="Next set are the same, big gear efforts"/><textevent timeoffset="20" message="But, this time STANDING"/><textevent timeoffset="30" message="Put your back into it!"/><textevent timeoffset="50" message="As before, big gear: 53x14"/><textevent timeoffset="120" message="Slow start, high torque effort coming up"/><textevent timeoffset="150" message="Switch down the block"/><textevent timeoffset="160" message="Lower your cadence and speed"/><textevent timeoffset="170" message="Are you ready to rumble?"/></SteadyState>
<IntervalsT   Repeat="3" OnDuration="7" OnPower="3.5" OffDuration="120" OffPower="0.55000001192093">
</IntervalsT>
<SteadyState  Duration="180" Power="0.55000001192093"><textevent timeoffset="10" message="Great work!"/><textevent timeoffset="30" message="The next set is the POWER SPRINTS"/><textevent timeoffset="50" message="This time, roll into the sprint: 85-90 rpm"/><textevent timeoffset="70" message="Try and hit peak power in each sprint"/><textevent timeoffset="90" message="Working with Cadence and Torque"/><textevent timeoffset="120" message="Once you launch, try not to change gear"/><textevent timeoffset="200" message="Each sprint is a STANDING effort"/><textevent timeoffset="260" message="Ok, ready?"/></SteadyState>
<IntervalsT   Repeat="3" OnDuration="7" OnPower="3.5" OffDuration="120" OffPower="0.55000001192093">
</IntervalsT>
<SteadyState  Duration="180" Power="0.55000001192093"><textevent timeoffset="0" message="Fantastic!"/><textevent timeoffset="30" message="Final set coming up"/><textevent timeoffset="60" message="Give this last set 100%"/><textevent timeoffset="80" message="3 x double sprints"/><textevent timeoffset="90" message="First 10sec is High torque"/><textevent timeoffset="100" message="The same as the first 2 sets"/><textevent timeoffset="110" message="Then 20 seconds easy to keep the gear turning"/><textevent timeoffset="120" message="Finish with 7sec full"/><textevent timeoffset="200" message="Let&#039;s get ready to go"/><textevent timeoffset="280" message="Change to 53x14 for the first 10sec effort"/></SteadyState>
<SteadyState  Duration="10" Power="3"></SteadyState>
<SteadyState  Duration="20" Power="0.40000000596046"><textevent timeoffset="10" message="Change to an easier gear"/></SteadyState>
<SteadyState  Duration="7" Power="2.5"></SteadyState>
<SteadyState  Duration="120" Power="0.55000001192093"><textevent timeoffset="0" message="a few minutes easy to Recover! "/></SteadyState>
<SteadyState  Duration="10" Power="3"></SteadyState>
<SteadyState  Duration="20" Power="0.40000000596046"></SteadyState>
<SteadyState  Duration="7" Power="2.5"></SteadyState>
<SteadyState  Duration="120" Power="0.55449998378754"><textevent timeoffset="0" message="a few minutes easy to Recover! "/></SteadyState>
<SteadyState  Duration="263" Power="0.55000001192093"><textevent timeoffset="50" message="Great session everyone"/><textevent timeoffset="90" message="Spin the legs easy to finish"/><textevent timeoffset="120" message="Another great session."/><textevent timeoffset="190" message="Hopefully your legs are still attached"/><textevent timeoffset="300" message="Enjoy the rest of the day!"/></SteadyState>
</workout></workout_file>